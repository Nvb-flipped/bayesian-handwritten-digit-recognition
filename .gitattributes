# Preserve Python bytes recorded in experiment provenance on Windows checkouts.
* text=auto
*.py text eol=lf
*.json text eol=lf
*.tex text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
# Preserve literal generated SVG bytes recorded in export validation hashes.
*.svg -text
*.pdf binary
*.png binary
*.pt binary
*.npz binary
*.joblib binary
